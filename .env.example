# Copy to .env and fill in.
#
# LocalStack retired its Community edition in March 2026, so an auth token is required
# even on the free Hobby tier. Sign up at https://app.localstack.cloud and copy the token
# from the workspace settings.
#
# Note on licensing: the Hobby tier is for non-commercial use. If this kata is part of a
# hiring process, it is worth confirming with the mentor whether a licence is provided.
LOCALSTACK_AUTH_TOKEN=

# Set to 1 for verbose LocalStack output when a deploy misbehaves.
LOCALSTACK_DEBUG=0
